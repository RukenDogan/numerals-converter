import re # Module de manipulation de chaînes de caractères

print("Conversion chiffre romain <-> chiffre arabe")

def is_roman_number(num):

    pattern = re.compile(r"""   
                                ^M{0,3}
                                (CM|CD|D?C{0,3})?
                                (XC|XL|L?X{0,3})?
                                (IX|IV|V?I{0,3})?$
            """, re.VERBOSE)

    if re.match(pattern, num):
        return True

    return False

# Fonction de conversion romain vers arabe
def conversion_romain_arabe(chiffre_romain):
    # Dictionnaire de conversion :
    conversion_nb = {
        "I": 1,
        "IV": 4,
        "V": 5,
        "IX": 9,
        "X": 10,
        "XL": 40,
        "L": 50,
        "XC": 90,
        "C": 100,
        "CD": 400,
        "D": 500,
        "CM": 900,
        "M": 1000
    }

    i = 0 # Index pour parcourir le chiffre romain
    resultat = 0 # Initialisation du résultat à 0

    while i < len(chiffre_romain): # Pour chaque caractère du chiffre romain
        if i+1 < len(chiffre_romain) and chiffre_romain[i:i+2] in conversion_nb: # Vérifie si les deux caractères forment une clé valide
            resultat += conversion_nb[chiffre_romain[i:i+2]] # Ajoute la valeur correspondante à la chaîne de caractères
            i += 2 # Incrémente de 2 pour passer au caractère suivant
        else:
            resultat += conversion_nb[chiffre_romain[i]] # Ajoute la valeur correspondante à la chaîne de caractères
            i += 1 # Incrémente de 1 pour passer au caractère suivant

    print(resultat) # Affichage du résultat

chiffre_romain = input("Entrez un chiffre romain : ").upper() # Saisie utilisateur et conversion en majuscules
if not is_roman_number(chiffre_romain):
    print("Chiffre romain invalide")
else:
    conversion_romain_arabe(chiffre_romain)
